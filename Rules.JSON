    {
      "id": "POSTA-001",
      "name": "OC31 TC51/TC52 gépi kitöltés, sornyomtatásos bizonylat",
      "conditions": {
        "all": [
          {
            "field": "paymentType",
            "operator": "equals",
            "value": "CashTransferOrder"
          },
          {
            "field": "outputCode",
            "operator": "equals",
            "value": "31"
          },
          {
            "field": "transactionCode",
            "operator": "in",
            "value": ["51", "52"]
          },
          {
            "field": "dataDeliveryType",
            "operator": "equals",
            "value": "PrintedDocument"
          }
        ]
      },
      "result": {
        "decision": "FeeApplicable",
        "fee": {
          "fixedFtPerItem": 188,
